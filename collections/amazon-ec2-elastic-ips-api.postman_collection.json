          "name": "Amazon EC2 Allocate an Elastic IP Address",
          "request": {
            "name": "Amazon EC2 Allocate an Elastic IP Address",
            "description": {
              "content": "Allocates an Elastic IP address to your AWS account. After you allocate the Elastic IP address you can associate it with an instance or network interface.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "Action",
                  "value": "AllocateAddress"
                },
                {
                  "disabled": false,
                  "key": "Domain",
                  "value": "<string>",
                  "description": "Set to vpc to allocate the address for use with instances in a VPC"
                }
              ],
              "variable": [
                {
                  "description": "AWS Region",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
